<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same LibHac Ryujinx uses, so base + update RomFS merges exactly like the emulator. -->
    <PackageReference Include="Ryujinx.LibHac" Version="0.21.0-alpha.133" />
  </ItemGroup>

</Project>
